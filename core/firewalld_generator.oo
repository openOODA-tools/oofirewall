// # firewalld Declarative Generator
//
// Logline: Generates and validates standard firewalld XML zone and service definitions.
//
// Setup: Pure XML generator conforming to Fedora Server /etc/firewalld schemas.
//
// Beats:
//   1. Build XML zone definition blocks with target and description metadata.
//   2. Serialize bound network interfaces and allowed CIDR sources.
//   3. Serialize enabled firewalld services (ssh, cockpit, http) and custom ports.
//   4. Deliver valid firewalld XML configuration payloads.

import "core/firewall_model.oo";

pub fn generate_zone_xml(z: ZoneConfig) -> String {
    let mut out: String = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n";
    out = out + "<zone" + (if z.target != "default" { " target=\"" + z.target + "\"" } else { "" }) + ">\n";
    out = out + "  <short>" + z.name + "</short>\n";
    out = out + "  <description>" + z.short_desc + "</description>\n";

    let n_ifaces: Int = list_len(z.interfaces);
    let mut i: Int = 0;
    while i < n_ifaces {
        out = out + "  <interface name=\"" + list_get(z.interfaces, i) + "\"/>\n";
        i = i + 1;
    }

    let n_sources: Int = list_len(z.sources);
    let mut s_idx: Int = 0;
    while s_idx < n_sources {
        out = out + "  <source address=\"" + list_get(z.sources, s_idx) + "\"/>\n";
        s_idx = s_idx + 1;
    }

    let n_services: Int = list_len(z.services);
    let mut sv_idx: Int = 0;
    while sv_idx < n_services {
        out = out + "  <service name=\"" + list_get(z.services, sv_idx) + "\"/>\n";
        sv_idx = sv_idx + 1;
    }

    let n_ports: Int = list_len(z.ports);
    let mut p_idx: Int = 0;
    while p_idx < n_ports {
        let p: PortSpec = list_get(z.ports, p_idx);
        out = out + "  <port port=\"" + p.port.to_string() + "\" protocol=\"" + p.protocol + "\"/>\n";
        p_idx = p_idx + 1;
    }

    let n_rules: Int = list_len(z.rules);
    let mut r_idx: Int = 0;
    while r_idx < n_rules {
        let r: RuleSpec = list_get(z.rules, r_idx);
        out = out + "  <rule family=\"ipv4\">\n";
        if chars_len(r.source_cidr) > 0 {
            out = out + "    <source address=\"" + r.source_cidr + "\"/>\n";
        }
        if r.port > 0 {
            out = out + "    <port port=\"" + r.port.to_string() + "\" protocol=\"" + r.protocol + "\"/>\n";
        }
        if chars_len(r.rate_limit) > 0 {
            out = out + "    <limit value=\"" + r.rate_limit + "\"/>\n";
        }
        out = out + "    <" + r.action + "/>\n";
        out = out + "  </rule>\n";
        r_idx = r_idx + 1;
    }

    out = out + "</zone>\n";
    return out;
}

pub fn generate_service_xml(name: String, desc: String, ports: List[PortSpec]) -> String {
    let mut out: String = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n";
    out = out + "<service>\n";
    out = out + "  <short>" + name + "</short>\n";
    out = out + "  <description>" + desc + "</description>\n";

    let n: Int = list_len(ports);
    let mut i: Int = 0;
    while i < n {
        let p: PortSpec = list_get(ports, i);
        out = out + "  <port port=\"" + p.port.to_string() + "\" protocol=\"" + p.protocol + "\"/>\n";
        i = i + 1;
    }

    out = out + "</service>\n";
    return out;
}
