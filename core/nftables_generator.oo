// # nftables Ruleset Generator
//
// Logline: Compiles firewall zones and port specifications into declarative Linux nftables rulesets.
//
// Setup: Pure string generator producing syntax-validated nftables configuration blocks.
//
// Beats:
//   1. Build table declaration (table inet filter).
//   2. Define input chain with connection tracking and drop/reject baseline policies.
//   3. Compile port and service rules into kernel packet verdicts.
//   4. Emit complete forward and output chain specifications.

import "core/firewall_model.oo";

pub fn generate_nftables_ruleset(zones: List[ZoneConfig]) -> String {
    let mut out: String = "#!/usr/sbin/nft -f\n"
        + "# Generated by openOODA oofirewall (declarative packet filtering)\n\n"
        + "flush ruleset\n\n"
        + "table inet filter {\n"
        + "    chain input {\n"
        + "        type filter hook input priority filter; policy drop;\n"
        + "        ct state established,related accept\n"
        + "        ct state invalid drop\n"
        + "        iif \"lo\" accept\n"
        + "        ip protocol icmp accept\n"
        + "        ip6 nexthdr ipv6-icmp accept\n";

    let n_zones: Int = list_len(zones);
    let mut z_idx: Int = 0;
    while z_idx < n_zones {
        let z: ZoneConfig = list_get(zones, z_idx);
        out = out + "\n        # Zone: " + z.name + "\n";

        // Interface bindings
        let n_ifaces: Int = list_len(z.interfaces);
        let mut i: Int = 0;
        while i < n_ifaces {
            let iface: String = list_get(z.interfaces, i);
            if iface != "lo" {
                out = out + "        # bound to interface: " + iface + "\n";
            }
            i = i + 1;
        }

        // Allowed ports
        let n_ports: Int = list_len(z.ports);
        let mut p_idx: Int = 0;
        while p_idx < n_ports {
            let p: PortSpec = list_get(z.ports, p_idx);
            out = out + "        " + p.protocol + " dport " + p.port.to_string() + " accept\n";
            p_idx = p_idx + 1;
        }

        // Custom rules
        let n_rules: Int = list_len(z.rules);
        let mut r_idx: Int = 0;
        while r_idx < n_rules {
            let r: RuleSpec = list_get(z.rules, r_idx);
            let mut line: String = "        ";
            if chars_len(r.source_cidr) > 0 {
                line = line + "ip saddr " + r.source_cidr + " ";
            }
            if r.port > 0 {
                line = line + r.protocol + " dport " + r.port.to_string() + " ";
            }
            if chars_len(r.rate_limit) > 0 {
                line = line + "limit rate " + r.rate_limit + " ";
            }
            line = line + r.action + "\n";
            out = out + line;
            r_idx = r_idx + 1;
        }

        z_idx = z_idx + 1;
    }

    out = out + "    }\n\n"
        + "    chain forward {\n"
        + "        type filter hook forward priority filter; policy drop;\n"
        + "    }\n\n"
        + "    chain output {\n"
        + "        type filter hook output priority filter; policy accept;\n"
        + "    }\n"
        + "}\n";

    return out;
}
