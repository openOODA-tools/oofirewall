// # MCP Server Subsystem
//
// Logline: Implements JSON-RPC 2.0 Model Context Protocol stdio server for firewall inspection.
//
// Setup: Pure IPC message parser dispatching declarative firewall tools across stdin/stdout.
//
// Beats:
//   1. Handle protocol handshake (initialize) and advertise tools/list.
//   2. Dispatch tool calls: firewall_inspect_rules, firewall_ruleset, firewall_plan_change.
//   3. Dispatch catalog and audit tools: firewall_zones, firewall_audit, firewall_demo.
//   4. Emit formatted JSON-RPC 2.0 responses.

import "core/firewall_model.oo";
import "core/firewalld_generator.oo";
import "core/nftables_generator.oo";
import "core/firewall_auditor.oo";
import "render/render_table.oo";
import "render/render_json.oo";
import "ipc/json_field.oo";

fn json_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 34 { out = out + "\\\""; }
        else if b == 92 { out = out + "\\\\"; }
        else if b == 10 { out = out + "\\n"; }
        else if b == 9 { out = out + "\\t"; }
        else if b == 13 { out = out + "\\r"; }
        else { out = out + char_at(s, i); }
        i = i + 1;
    }
    return out;
}

pub fn render_mcp_init(id_str: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_str + ",\"result\":{"
        + "\"protocolVersion\":\"2024-11-05\","
        + "\"capabilities\":{\"tools\":{}},"
        + "\"serverInfo\":{\"name\":\"oofirewall\",\"version\":\"0.2.0\"}"
        + "}}\n";
}

pub fn render_mcp_tools_list(id_str: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_str + ",\"result\":{\"tools\":["
        + "{\"name\":\"firewall_inspect_rules\",\"description\":\"Inspects active ports, services, and policies for a target zone.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"zone\":{\"type\":\"string\"}},\"required\":[\"zone\"]}},"
        + "{\"name\":\"firewall_ruleset\",\"description\":\"Compiles declarative ruleset into Linux nftables or firewalld XML format.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"format\":{\"type\":\"string\"}}}},"
        + "{\"name\":\"firewall_plan_change\",\"description\":\"Plans a declarative mutation to open/close ports or services.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"zone\":{\"type\":\"string\"},\"action\":{\"type\":\"string\"},\"target\":{\"type\":\"string\"}},\"required\":[\"zone\",\"action\",\"target\"]}},"
        + "{\"name\":\"firewall_zones\",\"description\":\"Lists all configured firewall zones and basic summaries.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
        + "{\"name\":\"firewall_audit\",\"description\":\"Audits current firewall configuration against Fedora Server security standards.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},"
        + "{\"name\":\"firewall_demo\",\"description\":\"Runs interactive multi-zone firewall configuration showcase.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}"
        + "]}}\n";
}

fn render_tool_result(id_str: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_str + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\""
        + json_escape(text) + "\"}]}}\n";
}

pub fn handle_mcp_request(raw_line: String) -> String {
    let id_val: Int = json_extract_int_field(raw_line, "id", 1);
    let id_str: String = id_val.to_string();
    let method: String = json_extract_str_field(raw_line, "method");

    if method == "initialize" {
        return render_mcp_init(id_str);
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return render_mcp_tools_list(id_str);
    }
    if method == "tools/call" {
        let tool_name: String = json_extract_str_field(raw_line, "name");

        if tool_name == "firewall_inspect_rules" {
            let zone_name: String = json_extract_str_field(raw_line, "zone");
            let z: ZoneConfig = if zone_name == "trusted" { make_trusted_zone() } else if zone_name == "drop" { make_drop_zone() } else { make_public_zone() };
            return render_tool_result(id_str, render_zone_status(z));
        }
        if tool_name == "firewall_ruleset" {
            let fmt: String = json_extract_str_field(raw_line, "format");
            let mut zones: List[ZoneConfig] = list_new();
            zones = list_push(zones, make_public_zone());
            zones = list_push(zones, make_trusted_zone());
            let out: String = if fmt == "xml" { generate_zone_xml(make_public_zone()) } else { generate_nftables_ruleset(zones) };
            return render_tool_result(id_str, out);
        }
        if tool_name == "firewall_plan_change" {
            let z_name: String = json_extract_str_field(raw_line, "zone");
            let action: String = json_extract_str_field(raw_line, "action");
            let target: String = json_extract_str_field(raw_line, "target");
            return render_tool_result(id_str, render_planned_change_json(z_name, action, target));
        }
        if tool_name == "firewall_zones" {
            let mut zones: List[ZoneConfig] = list_new();
            zones = list_push(zones, make_public_zone());
            zones = list_push(zones, make_trusted_zone());
            zones = list_push(zones, make_drop_zone());
            return render_tool_result(id_str, render_all_zones_json(zones));
        }
        if tool_name == "firewall_audit" {
            let mut zones: List[ZoneConfig] = list_new();
            zones = list_push(zones, make_public_zone());
            let findings: List[AuditFinding] = audit_firewall_configuration(zones);
            return render_tool_result(id_str, render_audit_report_json(findings));
        }
        if tool_name == "firewall_demo" {
            return render_tool_result(id_str, render_demo_showcase());
        }

        return "{\"jsonrpc\":\"2.0\",\"id\":" + id_str + ",\"error\":{\"code\":-32601,\"message\":\"Unknown tool: " + json_escape(tool_name) + "\"}}\n";
    }

    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_str + ",\"error\":{\"code\":-32601,\"message\":\"Method not found: " + json_escape(method) + "\"}}\n";
}

fn find_newline_pos(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        if byte_at(s, i) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn run_mcp_server(fr: &FsReadCap) {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fr, 4096);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = find_newline_pos(buf);
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let resp: String = handle_mcp_request(trimmed);
                        if chars_len(resp) > 0 {
                            print(resp);
                        }
                    }
                    nl_pos = find_newline_pos(buf);
                }
            }
        }
    }
}
