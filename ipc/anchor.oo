// # IPC Subsystem Anchor
//
// Logline: Unit tests for JSON extraction, CLI options parsing, and MCP message dispatch.
//
// Setup: Pure verification of JSON parsing and protocol handling without socket or disk I/O.
//
// Beats:
//   1. Verify JSON token scanning and field extraction.
//   2. Verify CLI argument parsing for zone, audit, and generation flags.
//   3. Verify MCP message handler dispatching for initialize and tools list.

import "ipc/json_field.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";

fn str_contains(s: String, needle: String) -> Bool {
    let n_len: Int = chars_len(needle);
    let s_len: Int = chars_len(s);
    if n_len > s_len {
        return false;
    }
    let mut i: Int = 0;
    while i + n_len <= s_len {
        if str_slice(s, i, i + n_len) == needle {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn test_json_parsing() -> Bool {
    let raw: String = "{\"zone\":\"public\",\"action\":\"add-port\",\"port\":8080}";
    let z: String = json_extract_str_field(raw, "zone");
    if z != "public" {
        return false;
    }
    let act: String = json_extract_str_field(raw, "action");
    if act != "add-port" {
        return false;
    }
    let p: Int = json_extract_int_field(raw, "port", 0);
    if p != 8080 {
        return false;
    }
    return true;
}

fn test_cli_parsing() -> Bool {
    let mut args: List[String] = list_new();
    args = list_push(args, "--zone");
    args = list_push(args, "trusted");
    args = list_push(args, "--generate-nft");
    args = list_push(args, "--audit");

    let opts: FirewallOpts = parse_cli_args(args);
    if opts.zone != "trusted" {
        return false;
    }
    if !opts.generate_nft {
        return false;
    }
    if !opts.audit_mode {
        return false;
    }
    return true;
}

fn test_mcp_dispatch() -> Bool {
    let init_res: String = render_mcp_init("1");
    if !str_contains(init_res, "oofirewall") || !str_contains(init_res, "0.2.0") {
        return false;
    }

    let list_res: String = render_mcp_tools_list("2");
    if !str_contains(list_res, "firewall_inspect_rules") || !str_contains(list_res, "firewall_ruleset") {
        return false;
    }
    if !str_contains(list_res, "firewall_plan_change") || !str_contains(list_res, "firewall_audit") {
        return false;
    }

    let req_zones: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"name\":\"firewall_zones\"}";
    let res_zones: String = handle_mcp_request(req_zones);
    if !str_contains(res_zones, "public") || !str_contains(res_zones, "trusted") {
        return false;
    }

    return true;
}

pub fn run_ipc_tests() -> Bool {
    if !test_json_parsing() {
        return false;
    }
    if !test_cli_parsing() {
        return false;
    }
    if !test_mcp_dispatch() {
        return false;
    }
    return true;
}
